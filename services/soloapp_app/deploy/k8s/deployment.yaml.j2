apiVersion: v1
kind: List
items:
- apiVersion: v1
  kind: ServiceAccount
  metadata: {name: whoami-secrets, namespace: soloapp}
  automountServiceAccountToken: false
- apiVersion: apps/v1
  kind: Deployment
  metadata: {name: whoami, namespace: soloapp}
  spec:
    replicas: {{ whoami_config.replicas }}
    minReadySeconds: {{ whoami_config.min_ready_seconds }}
    progressDeadlineSeconds: 300
    strategy:
      type: RollingUpdate
      rollingUpdate: {{ whoami_config.rolling_update | to_json }}
    selector:
      matchLabels: {app: whoami}
    template:
      metadata:
        labels: {app: whoami, soloapp.io/backend: whoami}
      spec:
        automountServiceAccountToken: false
        serviceAccountName: whoami-secrets
        terminationGracePeriodSeconds: {{ whoami_config.termination_grace_seconds }}
        securityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
        containers:
        - name: whoami
          image: "{{ whoami_config.image }}"
          imagePullPolicy: {{ whoami_config.image_pull_policy }}
          env:
          - name: HEALTH_ERROR_THRESHOLD
            value: '{{ whoami_config.health.error_threshold }}'
          - name: HEALTH_WINDOW_SECONDS
            value: '{{ whoami_config.health.window_seconds }}'
          - name: HEALTH_COOLDOWN_SECONDS
            value: '{{ whoami_config.health.cooldown_seconds }}'
          - {name: HMAC_KEY_FILE, value: /run/soloapp-secrets/data/userid-hmac}
          - {name: CHAT_ALLOWED_ORIGIN, value: 'https://{{ public_domain }}'}
          - {name: PORT, value: '{{ whoami_config.port }}'}
          - {name: LISTEN_ADDRESS, value: '0.0.0.0'}
          - {name: LLAMA_URL, value: 'http://llama.soloapp.svc.cluster.local:8180'}
          - {name: TTS_URL, value: 'http://tts.soloapp.svc.cluster.local:8179'}
          ports: [{name: http, containerPort: {{ whoami_config.port }}}]
          resources: {{ whoami_config.resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: secrets, mountPath: /run/soloapp-secrets, readOnly: true}
          lifecycle:
            preStop:
              exec: {command: [/bin/sleep, '15']}
          startupProbe:
            httpGet: {path: /healthz, port: http}
            periodSeconds: {{ whoami_config.probes.startup.period_seconds }}
            timeoutSeconds: {{ whoami_config.probes.startup.timeout_seconds }}
            failureThreshold: {{ whoami_config.probes.startup.failure_threshold }}
          readinessProbe:
            httpGet: {path: /health/ready, port: http}
            periodSeconds: {{ whoami_config.probes.readiness.period_seconds }}
            timeoutSeconds: {{ whoami_config.probes.readiness.timeout_seconds }}
            failureThreshold: {{ whoami_config.probes.readiness.failure_threshold }}
            successThreshold: {{ whoami_config.probes.readiness.success_threshold }}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
            periodSeconds: {{ whoami_config.probes.liveness.period_seconds }}
            timeoutSeconds: {{ whoami_config.probes.liveness.timeout_seconds }}
            failureThreshold: {{ whoami_config.probes.liveness.failure_threshold }}
        - name: refresh-secrets
          image: '{{ secrets_image }}'
          imagePullPolicy: Never
          command: [python3, /usr/local/bin/secret-fetch.py]
          env:
          - {name: TOKEN_FILE, value: /run/identity/token}
          - {name: SERVICE_ACCOUNT_ID, value: '{{ cloud.identities["whoami-" ~ inventory_hostname] }}'}
          - {name: SECRET_IDS, value: '{{ cloud.secrets["whoami-" ~ inventory_hostname] }},{{ cloud.secrets["chat-api-tls-" ~ inventory_hostname] }}'}
          - {name: SECRET_DIR, value: /run/soloapp-secrets/data}
          - {name: LOOP, value: '1'}
          resources:
            requests: {cpu: 10m, memory: 24Mi}
            limits: {cpu: 200m, memory: 64Mi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: identity, mountPath: /run/identity, readOnly: true}
          - {name: secrets, mountPath: /run/soloapp-secrets}
        initContainers:
        - name: fetch-secrets
          image: '{{ secrets_image }}'
          imagePullPolicy: Never
          command: [python3, /usr/local/bin/secret-fetch.py]
          env:
          - {name: TOKEN_FILE, value: /run/identity/token}
          - {name: SERVICE_ACCOUNT_ID, value: '{{ cloud.identities["whoami-" ~ inventory_hostname] }}'}
          - {name: SECRET_IDS, value: '{{ cloud.secrets["whoami-" ~ inventory_hostname] }},{{ cloud.secrets["chat-api-tls-" ~ inventory_hostname] }}'}
          - {name: SECRET_DIR, value: /run/soloapp-secrets/data}
          resources:
            requests: {cpu: 10m, memory: 24Mi}
            limits: {cpu: 200m, memory: 64Mi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: identity, mountPath: /run/identity, readOnly: true}
          - {name: secrets, mountPath: /run/soloapp-secrets}
        volumes:
        - name: secrets
          emptyDir: {medium: Memory, sizeLimit: 4Mi}
        - name: identity
          projected:
            sources:
            - serviceAccountToken: {path: token, expirationSeconds: 600, audience: soloapp-lockbox}
