apiVersion: v1
kind: Service
metadata: {name: whoami, namespace: soloapp}
spec:
  type: ClusterIP
  selector: {soloapp.io/backend: whoami}
  ports: [{name: http, port: {{ whoami_config.port }}, targetPort: http}]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata: {name: whoami, namespace: soloapp}
spec:
  maxUnavailable: 1
  selector:
    matchLabels: {app: whoami}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: whoami, namespace: soloapp}
spec:
  podSelector:
    matchLabels: {app: whoami}
  policyTypes: [Ingress]
  ingress:
  - from:
    - podSelector:
        matchLabels: {soloapp.io/backend: auth}
    - podSelector:
        matchLabels: {soloapp.io/backend: nginx}
    ports: [{protocol: TCP, port: {{ whoami_config.port }}}]
