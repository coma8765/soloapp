worker_processes 2;
worker_shutdown_timeout 25s;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
{{ lookup('template', project_root ~ '/services/nginx/deploy/generated/maps.conf.j2') | indent(2, true) }}
  map $request_method $observed_method { default OTHER; GET GET; POST POST; PUT PUT; DELETE DELETE; OPTIONS OPTIONS; HEAD HEAD; PATCH PATCH; }
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  log_format observability escape=json '{"service":"$observed_service","route":"$observed_route","method":"$observed_method","status":"$status","request_time":$request_time,"upstream_time":"$upstream_response_time","bytes":$body_bytes_sent}';
  map $uri $observed_loggable { default 1; /grafana/api/health 0; }
  access_log /dev/stdout observability if=$observed_loggable;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  server_tokens off;
  client_max_body_size 8k;
  set_real_ip_from 10.77.26.0/24;
  real_ip_header X-Forwarded-For;
  limit_req_status 429;
  server { listen 0.0.0.0:{{ nginx_config.health_port }}; access_log off; location = /ready { access_log off; proxy_pass http://auth.soloapp.svc.cluster.local:{{ auth_config.port }}/ready; } location = /healthz { access_log off; return 200 "ok"; } location / { return 404; } }
  server {
    listen 0.0.0.0:{{ nginx_config.port }} ssl;
    ssl_certificate /run/soloapp-secrets/data/tls.crt;
    ssl_certificate_key /run/soloapp-secrets/data/tls.key;
    ssl_client_certificate /run/soloapp-secrets/data/ca.crt;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($ssl_client_s_dn !~ "^CN=ingress-(yc|edge)$") { return 403; }
    add_header X-Solo-Site {{ inventory_hostname }} always;
    add_header Cache-Control "no-store" always;
    location = /healthz { access_log off; return 200 "ok"; }
{% if obs.public_grafana %}
    location = /grafana { return 308 /grafana/; }
    location /grafana/ {
      proxy_pass https://{{ private_ip }}:{{ obs.gateway_node_port }};
      proxy_ssl_trusted_certificate /run/soloapp-secrets/data/ca.crt;
      proxy_ssl_certificate /run/soloapp-secrets/data/tls.crt;
      proxy_ssl_certificate_key /run/soloapp-secrets/data/tls.key;
      proxy_ssl_verify on;
      proxy_ssl_name {{ obs.gateway_names[inventory_hostname] }};
      proxy_ssl_server_name on;
      proxy_set_header Host {{ public_domain }};
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_http_version 1.1;
      proxy_read_timeout 60s;
    }
{% endif %}
{{ lookup('template', project_root ~ '/services/nginx/deploy/generated/routes.conf.j2') | indent(4, true) }}
{% if web_config.release | length > 0 %}
    location = / {
      if ($request_method !~ ^(GET|HEAD)$) { return 405; }
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_pass http://web.soloapp.svc.cluster.local:{{ web_config.port }};
    }
    location /web/releases/ {
      if ($request_method !~ ^(GET|HEAD)$) { return 405; }
      proxy_set_header Authorization "";
      proxy_set_header Cookie "";
      proxy_connect_timeout 2s;
      proxy_read_timeout 20s;
      proxy_hide_header Cache-Control;
      add_header Cache-Control $upstream_http_cache_control always;
      add_header X-Solo-Site {{ inventory_hostname }} always;
      proxy_pass http://web.soloapp.svc.cluster.local:{{ web_config.port }};
    }
{% endif %}
    location / { return 404; }
  }
}
