apiVersion: v1
kind: Service
metadata: {name: nginx, namespace: soloapp}
spec:
  type: NodePort
  externalTrafficPolicy: Local
  selector: {soloapp.io/backend: nginx}
  ports: [{name: https, port: {{ nginx_config.port }}, targetPort: https, nodePort: {{ nginx_config.node_port }}}]
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata: {name: nginx, namespace: soloapp}
spec:
  maxUnavailable: 1
  selector:
    matchLabels: {app: nginx}
