apiVersion: v1
kind: List
items:
- apiVersion: v1
  kind: ServiceAccount
  metadata: {name: nginx-secrets, namespace: soloapp}
  automountServiceAccountToken: false
- apiVersion: apps/v1
  kind: Deployment
  metadata: {name: nginx, namespace: soloapp}
  spec:
    replicas: {{ nginx_config.replicas }}
    minReadySeconds: {{ nginx_config.min_ready_seconds }}
    progressDeadlineSeconds: 300
    strategy:
      type: RollingUpdate
      rollingUpdate: {{ nginx_config.rolling_update | to_json }}
    selector:
      matchLabels: {app: nginx}
    template:
      metadata:
        labels: {app: nginx, soloapp.io/backend: nginx}
      spec:
        automountServiceAccountToken: false
        shareProcessNamespace: true
        serviceAccountName: nginx-secrets
        terminationGracePeriodSeconds: {{ nginx_config.termination_grace_seconds }}
        securityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
        containers:
        - name: nginx
          image: "{{ nginx_config.image }}"
          imagePullPolicy: {{ nginx_config.image_pull_policy }}
          ports: [{name: https, containerPort: {{ nginx_config.port }}}]
          command: [nginx, '-g', 'daemon off;']
          resources: {{ nginx_config.resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: secrets, mountPath: /run/soloapp-secrets, readOnly: true}
          - {name: config, mountPath: /etc/nginx/nginx.conf, subPath: nginx.conf, readOnly: true}
          - {name: tmp, mountPath: /tmp}
          lifecycle:
            preStop:
              exec:
                command: [/bin/sh, -c, 'sleep 10; nginx -s quit; while kill -0 $(cat /tmp/nginx.pid 2>/dev/null) 2>/dev/null; do sleep 1; done']
          startupProbe:
            httpGet: {path: /healthz, port: {{ nginx_config.health_port }}}
            periodSeconds: {{ nginx_config.probes.startup.period_seconds }}
            timeoutSeconds: {{ nginx_config.probes.startup.timeout_seconds }}
            failureThreshold: {{ nginx_config.probes.startup.failure_threshold }}
          readinessProbe:
            httpGet: {path: /healthz, port: {{ nginx_config.health_port }}}
            periodSeconds: {{ nginx_config.probes.readiness.period_seconds }}
            timeoutSeconds: {{ nginx_config.probes.readiness.timeout_seconds }}
            failureThreshold: {{ nginx_config.probes.readiness.failure_threshold }}
            successThreshold: {{ nginx_config.probes.readiness.success_threshold }}
          livenessProbe:
            httpGet: {path: /healthz, port: {{ nginx_config.health_port }}}
            periodSeconds: {{ nginx_config.probes.liveness.period_seconds }}
            timeoutSeconds: {{ nginx_config.probes.liveness.timeout_seconds }}
            failureThreshold: {{ nginx_config.probes.liveness.failure_threshold }}
        - name: refresh-secrets
          image: '{{ secrets_image }}'
          imagePullPolicy: Never
          command: [python3, /usr/local/bin/secret-fetch.py]
          env:
          - {name: TOKEN_FILE, value: /run/identity/token}
          - {name: SERVICE_ACCOUNT_ID, value: '{{ cloud.identities["nginx-" ~ inventory_hostname] }}'}
          - {name: SECRET_IDS, value: '{{ cloud.secrets["nginx-" ~ inventory_hostname] }}'}
          - {name: SECRET_DIR, value: /run/soloapp-secrets/data}
          - {name: LOOP, value: '1'}
          - {name: RELOAD_NGINX, value: '1'}
          resources:
            requests: {cpu: 10m, memory: 24Mi}
            limits: {cpu: 200m, memory: 64Mi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: identity, mountPath: /run/identity, readOnly: true}
          - {name: secrets, mountPath: /run/soloapp-secrets}
          - {name: tmp, mountPath: /tmp}
        initContainers:
        - name: fetch-secrets
          image: '{{ secrets_image }}'
          imagePullPolicy: Never
          command: [python3, /usr/local/bin/secret-fetch.py]
          env:
          - {name: TOKEN_FILE, value: /run/identity/token}
          - {name: SERVICE_ACCOUNT_ID, value: '{{ cloud.identities["nginx-" ~ inventory_hostname] }}'}
          - {name: SECRET_IDS, value: '{{ cloud.secrets["nginx-" ~ inventory_hostname] }}'}
          - {name: SECRET_DIR, value: /run/soloapp-secrets/data}
          resources:
            requests: {cpu: 10m, memory: 24Mi}
            limits: {cpu: 200m, memory: 64Mi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: identity, mountPath: /run/identity, readOnly: true}
          - {name: secrets, mountPath: /run/soloapp-secrets}
        volumes:
        - name: config
          configMap:
            name: nginx-{{ (lookup('template', project_root ~ '/services/nginx/deploy/nginx.conf.j2') | hash('sha256'))[:16] }}
        - name: tmp
          emptyDir: {}
        - name: secrets
          emptyDir: {medium: Memory, sizeLimit: 4Mi}
        - name: identity
          projected:
            sources:
            - serviceAccountToken: {path: token, expirationSeconds: 600, audience: soloapp-lockbox}
