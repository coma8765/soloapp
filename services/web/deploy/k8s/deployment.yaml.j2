apiVersion: v1
kind: List
items:
- apiVersion: v1
  kind: ServiceAccount
  metadata:
    name: web-secrets
    namespace: soloapp
  automountServiceAccountToken: false
- apiVersion: apps/v1
  kind: Deployment
  metadata:
    name: web
    namespace: soloapp
  spec:
    replicas: {{ web_config.replicas }}
    minReadySeconds: {{ web_config.min_ready_seconds }}
    progressDeadlineSeconds: 300
    strategy:
      type: RollingUpdate
      rollingUpdate: {{ web_config.rolling_update | to_json }}
    selector:
      matchLabels:
        app: web
    template:
      metadata:
        labels:
          app: web
          soloapp.io/backend: web
      spec:
        dnsPolicy: ClusterFirst
        automountServiceAccountToken: false
        terminationGracePeriodSeconds: {{ web_config.termination_grace_seconds }}
        securityContext:
          runAsNonRoot: true
          runAsUser: 10001
          runAsGroup: 10001
          fsGroup: 10001
        containers:
        - name: web
          image: "{{ web_config.image }}"
          imagePullPolicy: {{ web_config.image_pull_policy }}
          env:
          - name: WEB_RELEASE
            value: '{{ web_config.release }}'
          volumeMounts:
          - name: secrets
            mountPath: /run/soloapp-secrets
            readOnly: true
          - name: cache
            mountPath: /cache
          ports: [{name: http, containerPort: {{ web_config.port }}}]
          resources: {{ web_config.resources | to_json }}
          lifecycle:
            preStop:
              exec: {command: [/bin/sleep, '20']}
          startupProbe:
            httpGet: {path: /healthz, port: http}
            periodSeconds: {{ web_config.probes.startup.period_seconds }}
            timeoutSeconds: {{ web_config.probes.startup.timeout_seconds }}
            failureThreshold: {{ web_config.probes.startup.failure_threshold }}
          readinessProbe:
            httpGet: {path: /ready, port: http}
            periodSeconds: {{ web_config.probes.readiness.period_seconds }}
            timeoutSeconds: {{ web_config.probes.readiness.timeout_seconds }}
            failureThreshold: {{ web_config.probes.readiness.failure_threshold }}
            successThreshold: {{ web_config.probes.readiness.success_threshold }}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
            periodSeconds: {{ web_config.probes.liveness.period_seconds }}
            timeoutSeconds: {{ web_config.probes.liveness.timeout_seconds }}
            failureThreshold: {{ web_config.probes.liveness.failure_threshold }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
              - ALL
        - name: refresh-secrets
          image: "{{ secrets_image }}"
          imagePullPolicy: Never
          command:
          - python3
          - /usr/local/bin/secret-fetch.py
          env:
          - name: TOKEN_FILE
            value: /run/identity/token
          - name: SERVICE_ACCOUNT_ID
            value: "{{ cloud.identities['web-' ~ inventory_hostname] }}"
          - name: SECRET_IDS
            value: "{{ cloud.secrets['web-' ~ inventory_hostname] }}"
          - name: SECRET_DIR
            value: /run/soloapp-secrets/data
          - name: LOOP
            value: '1'
          volumeMounts:
          - name: identity
            mountPath: /run/identity
            readOnly: true
          - name: secrets
            mountPath: /run/soloapp-secrets
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
              - ALL
          resources:
            requests:
              cpu: 10m
              memory: 24Mi
            limits:
              cpu: 200m
              memory: 64Mi
        volumes:
        - name: cache
          emptyDir:
            sizeLimit: 256Mi
        - name: secrets
          emptyDir:
            medium: Memory
            sizeLimit: 4Mi
        - name: identity
          projected:
            sources:
            - serviceAccountToken:
                path: token
                expirationSeconds: 600
                audience: soloapp-lockbox
        serviceAccountName: web-secrets
        initContainers:
        - name: fetch-secrets
          image: "{{ secrets_image }}"
          imagePullPolicy: Never
          command:
          - python3
          - /usr/local/bin/secret-fetch.py
          env:
          - name: TOKEN_FILE
            value: /run/identity/token
          - name: SERVICE_ACCOUNT_ID
            value: "{{ cloud.identities['web-' ~ inventory_hostname] }}"
          - name: SECRET_IDS
            value: "{{ cloud.secrets['web-' ~ inventory_hostname] }}"
          - name: SECRET_DIR
            value: /run/soloapp-secrets/data
          volumeMounts:
          - name: identity
            mountPath: /run/identity
            readOnly: true
          - name: secrets
            mountPath: /run/soloapp-secrets
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
              - ALL
          resources:
            requests:
              cpu: 10m
              memory: 24Mi
            limits:
              cpu: 200m
              memory: 64Mi
