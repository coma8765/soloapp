apiVersion: v1
kind: List
items:
- apiVersion: v1
  kind: ServiceAccount
  metadata: {name: client-notify-secrets, namespace: soloapp}
  automountServiceAccountToken: false
- apiVersion: apps/v1
  kind: Deployment
  metadata: {name: client-notify, namespace: soloapp}
  spec:
    replicas: {{ notify_config.replicas }}
    minReadySeconds: {{ notify_config.min_ready_seconds }}
    progressDeadlineSeconds: 300
    strategy:
      type: RollingUpdate
      rollingUpdate: {{ notify_config.rolling_update | to_json }}
    selector:
      matchLabels: {app: client-notify}
    template:
      metadata:
        labels: {app: client-notify, soloapp.io/backend: client-notify}
      spec:
        automountServiceAccountToken: false
        hostAliases:
        - ip: "{{ private_ip }}"
          hostnames: ["node-{{ inventory_hostname }}"]
        serviceAccountName: client-notify-secrets
        terminationGracePeriodSeconds: {{ notify_config.termination_grace_seconds }}
        securityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
        containers:
        - name: client-notify
          image: "{{ notify_config.image }}"
          imagePullPolicy: {{ notify_config.image_pull_policy }}
          env:
          - {name: NOTIFY_ACK_TIMEOUT_MS, value: '{{ notify_config.ack_timeout_ms }}'}
          - {name: NOTIFY_DELIVERY_TIMEOUT_MS, value: '{{ notify_config.delivery_timeout_ms }}'}
          - {name: NOTIFY_RETRY_DELAY_MS, value: '{{ notify_config.retry_delay_ms }}'}
          - {name: DATABASE_URL_FILE, value: /run/soloapp-secrets/data/database-url}
          - {name: NOTIFY_CONFIG_FILE, value: /run/soloapp-secrets/data/notify-config.json}
          - {name: NOTIFY_API_TOKEN_FILE, value: /run/soloapp-secrets/data/api-token}
          - {name: PORT, value: '{{ notify_config.port }}'}
          - {name: LISTEN_ADDRESS, value: '0.0.0.0'}
          ports: [{name: http, containerPort: {{ notify_config.port }}}]
          resources: {{ notify_config.resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: uploads, mountPath: /uploads}
          - {name: secrets, mountPath: /run/soloapp-secrets, readOnly: true}
          lifecycle:
            preStop:
              exec: {command: [/bin/sleep, '15']}
          startupProbe:
            httpGet: {path: /healthz, port: http}
            periodSeconds: {{ notify_config.probes.startup.period_seconds }}
            timeoutSeconds: {{ notify_config.probes.startup.timeout_seconds }}
            failureThreshold: {{ notify_config.probes.startup.failure_threshold }}
          readinessProbe:
            httpGet: {path: /health/ready, port: http}
            periodSeconds: {{ notify_config.probes.readiness.period_seconds }}
            timeoutSeconds: {{ notify_config.probes.readiness.timeout_seconds }}
            failureThreshold: {{ notify_config.probes.readiness.failure_threshold }}
            successThreshold: {{ notify_config.probes.readiness.success_threshold }}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
            periodSeconds: {{ notify_config.probes.liveness.period_seconds }}
            timeoutSeconds: {{ notify_config.probes.liveness.timeout_seconds }}
            failureThreshold: {{ notify_config.probes.liveness.failure_threshold }}
        - name: refresh-secrets
          image: '{{ secrets_image }}'
          imagePullPolicy: Never
          command: [python3, /usr/local/bin/secret-fetch.py]
          env:
          - {name: TOKEN_FILE, value: /run/identity/token}
          - {name: SERVICE_ACCOUNT_ID, value: '{{ cloud.identities["client-notify-" ~ inventory_hostname] }}'}
          - {name: SECRET_IDS, value: '{{ cloud.secrets["client-notify-" ~ inventory_hostname] }},{{ cloud.secrets["client-notify-tls-" ~ inventory_hostname] }}'}
          - {name: SECRET_DIR, value: /run/soloapp-secrets/data}
          - {name: LOOP, value: '1'}
          resources:
            requests: {cpu: 10m, memory: 24Mi}
            limits: {cpu: 200m, memory: 64Mi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: identity, mountPath: /run/identity, readOnly: true}
          - {name: secrets, mountPath: /run/soloapp-secrets}
        initContainers:
        - name: fetch-secrets
          image: '{{ secrets_image }}'
          imagePullPolicy: Never
          command: [python3, /usr/local/bin/secret-fetch.py]
          env:
          - {name: TOKEN_FILE, value: /run/identity/token}
          - {name: SERVICE_ACCOUNT_ID, value: '{{ cloud.identities["client-notify-" ~ inventory_hostname] }}'}
          - {name: SECRET_IDS, value: '{{ cloud.secrets["client-notify-" ~ inventory_hostname] }},{{ cloud.secrets["client-notify-tls-" ~ inventory_hostname] }}'}
          - {name: SECRET_DIR, value: /run/soloapp-secrets/data}
          resources:
            requests: {cpu: 10m, memory: 24Mi}
            limits: {cpu: 200m, memory: 64Mi}
          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
          volumeMounts:
          - {name: identity, mountPath: /run/identity, readOnly: true}
          - {name: secrets, mountPath: /run/soloapp-secrets}
        volumes:
        - name: uploads
          emptyDir: {medium: Memory, sizeLimit: 8Mi}
        - name: secrets
          emptyDir: {medium: Memory, sizeLimit: 4Mi}
        - name: identity
          projected:
            sources:
            - serviceAccountToken: {path: token, expirationSeconds: 600, audience: soloapp-lockbox}
