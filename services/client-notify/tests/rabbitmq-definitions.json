{
  "users": [
    {
      "name": "notifytest",
      "password": "synthetic-local-only",
      "tags": []
    }
  ],
  "vhosts": [
    {
      "name": "/soloapp"
    }
  ],
  "permissions": [
    {
      "user": "notifytest",
      "vhost": "/soloapp",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "client-notify",
      "vhost": "/soloapp",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-quorum-initial-group-size": 1,
        "x-delivery-limit": -1
      }
    }
  ]
}
