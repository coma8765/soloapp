# Shared service targets. Include after defining SERVICE and PROJECT_ROOT.
.DEFAULT_GOAL := build
DOCKER ?= docker
PYTHON ?= $(if $(wildcard $(PROJECT_ROOT)/.venv-codegen/bin/python),$(PROJECT_ROOT)/.venv-codegen/bin/python,python3)
IMAGE_PREFIX ?= soloapp
TAG ?= dev
IMAGE = $(IMAGE_PREFIX)/$(SERVICE):$(TAG)
TEST_IMAGE = $(IMAGE_PREFIX)/$(SERVICE)-tests:$(TAG)
DOCKERFILE = $(PROJECT_ROOT)/services/$(SERVICE)/deploy/Dockerfile

.PHONY: all build test test-image codegen check-codegen help
all: build

# CMake runs API and ODB codegen inside the existing Docker build stage.
build:
	$(DOCKER) build --target runtime -f "$(DOCKERFILE)" -t "$(IMAGE)" "$(PROJECT_ROOT)"

test-image:
	$(DOCKER) build --target tests -f "$(DOCKERFILE)" -t "$(TEST_IMAGE)" "$(PROJECT_ROOT)"

test: test-image
	$(DOCKER) run --rm "$(TEST_IMAGE)"

# This target generates the OpenAPI DTOs/routes; ODB is generated by build.
codegen:
	$(PYTHON) "$(PROJECT_ROOT)/libs/api_codegen/generate.py" "$(PROJECT_ROOT)/services/$(SERVICE)"

check-codegen:
	$(PYTHON) "$(PROJECT_ROOT)/libs/api_codegen/generate.py" "$(PROJECT_ROOT)/services/$(SERVICE)" --check

help:
	@printf '%s\n' '$(SERVICE): build (default), test, test-image, codegen, check-codegen' 'Overrides: DOCKER=docker PYTHON=python3 IMAGE_PREFIX=soloapp TAG=dev'
