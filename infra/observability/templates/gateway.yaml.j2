worker_processes 1;
pid /tmp/nginx.pid;
events { worker_connections 256; }
http {
  map $http_upgrade $headlamp_connection { default upgrade; '' close; }
  access_log off;
  client_body_temp_path /tmp/body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  server {
    listen 19091 ssl;
    ssl_certificate /run/soloapp-secrets/data/tls.crt;
    ssl_certificate_key /run/soloapp-secrets/data/tls.key;
    ssl_client_certificate /run/soloapp-secrets/data/ca.crt;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;
    location = /api/v1/write {
      if ($ssl_client_s_dn !~ "^CN=observability-(yc|home)$") { return 403; }
      proxy_pass http://prometheus:9090;
    }
    location = /loki/api/v1/push {
      if ($ssl_client_s_dn !~ "^CN=observability-(yc|home)$") { return 403; }
      proxy_pass http://loki:3100;
    }
    location /grafana/ {
      if ($ssl_client_s_dn !~ "^CN=nginx-(yc|home)$") { return 403; }
      proxy_pass http://grafana:3000;
      proxy_set_header Host {{ public_domain }};
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Authorization $http_authorization;
      proxy_http_version 1.1;
    }
    location /k8s/ {
      if ($ssl_client_s_dn !~ "^CN=nginx-(yc|home)$") { return 403; }
      # Resolve at request time: missing UI must not prevent the metrics gateway starting.
      resolver 10.{{ cluster_octet | int + 1 }}.0.10 valid=10s ipv6=off;
      set $headlamp_backend headlamp.observability.svc.cluster.local:4466;
      proxy_pass http://$headlamp_backend;
      proxy_set_header Host {{ public_domain }};
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $headlamp_connection;
      proxy_http_version 1.1;
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }
    location / { return 404; }
  }
  server { listen 19092; location = /healthz { return 200 "ok"; } location / { return 404; } }
}
