global:
  scrape_interval: {{ obs.scrape_interval }}
  evaluation_interval: 15s
scrape_configs:
- job_name: prometheus
  static_configs:
  - targets: ['127.0.0.1:9090']
rule_files: [/etc/prometheus/rules.yaml]
{% if obs.alertmanager.enabled %}
alerting:
  alertmanagers:
  - static_configs:
    - targets: ['alertmanager:9093']
{% endif %}
