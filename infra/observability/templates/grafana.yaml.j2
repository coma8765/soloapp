[server]
root_url = https://{{ public_domain }}/grafana/
serve_from_sub_path = true
[security]
admin_user = admin
admin_password = $__file{/run/soloapp-secrets/data/admin-password}
secret_key = $__file{/run/soloapp-secrets/data/secret-key}
cookie_secure = true
cookie_samesite = lax
disable_gravatar = true
[users]
allow_sign_up = false
[auth.anonymous]
enabled = false
[analytics]
reporting_enabled = false
check_for_updates = false
[plugins]
check_for_updates = false
[paths]
provisioning = /etc/grafana/provisioning
[log]
mode = console
level = warn

[dashboards]
default_home_dashboard_path = /var/lib/grafana/dashboards/infrastructure/soloapp.json

{% if oidc_enabled | default(false) %}
[auth.generic_oauth]
enabled = true
name = Soloapp Passkey
allow_sign_up = true
client_id = grafana
client_secret = $__file{/run/soloapp-secrets/data/client-secret}
scopes = openid profile email
auth_url = https://{{ public_domain }}/id/realms/soloapp/protocol/openid-connect/auth
token_url = https://{{ public_domain }}/id/realms/soloapp/protocol/openid-connect/token
api_url = https://{{ public_domain }}/id/realms/soloapp/protocol/openid-connect/userinfo
use_pkce = true
use_refresh_token = true
login_attribute_path = preferred_username
name_attribute_path = name
role_attribute_path = contains(grafana_roles[*], 'admin') && 'Admin' || contains(grafana_roles[*], 'editor') && 'Editor' || contains(grafana_roles[*], 'viewer') && 'Viewer' || 'None'
role_attribute_strict = true
skip_org_role_sync = false
allow_assign_grafana_admin = false
{% endif %}
