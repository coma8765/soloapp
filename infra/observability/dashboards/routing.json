    {
      "title": "3 \u00b7 Service \u2192 pod \u2014 ready endpoints",
      "type": "state-timeline",
      "description": "Actual EndpointSlice: UP=ready and not terminating; DOWN=not eligible for normal Service traffic. STALE after 20s; missing endpoint is a gap. Kube-proxy may briefly route to serving/terminating endpoints while draining existing traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(dc,endpointslice,targetref_name) ((kube_endpointslice_endpoints{namespace=\"soloapp\",dc=~\"$dc\",ready=\"true\",terminating!=\"true\"} or on(dc,endpointslice,address,targetref_name) 0 * kube_endpointslice_endpoints{namespace=\"soloapp\",dc=~\"$dc\"}) * (time() - timestamp(kube_endpointslice_endpoints{namespace=\"soloapp\",dc=~\"$dc\"}) < bool 20) + 2 * (time() - timestamp(kube_endpointslice_endpoints{namespace=\"soloapp\",dc=~\"$dc\"}) >= bool 20))",
