          "refId": "A",
          "expr": "increase(haproxy_server_check_up_down_total{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\"}[$__rate_interval])",
          "legendFormat": "{{observer}} / {{ingress}} \u2192 {{proxy}} / {{server}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
