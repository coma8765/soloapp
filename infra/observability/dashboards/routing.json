    {
      "title": "HAProxy \u2014 exclusions (UP \u2192 DOWN)",
      "type": "timeseries",
      "description": "Transitions counted by each HAProxy. Separate observers duplicate the same counter: do not sum them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
