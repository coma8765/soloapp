  "templating": {
    "list": [
      {
        "name": "dc",
        "type": "custom",
        "query": "yc,home",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "ingress",
        "type": "custom",
        "query": "yc,edge",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "observer",
        "type": "custom",
        "query": "yc,home",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "1 \u00b7 YC NLB \u2192 ingress \u2014 actual target state",
      "type": "state-timeline",
      "description": "YC getTargetStates decision, not an inferred HTTP probe. HEALTHY is eligible; UNHEALTHY/DRAINING/INACTIVE excluded. UNKNOWN means no authoritative state. Check poll freshness below. Samples older than 20s are STALE; consult collector status before interpreting routing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((0 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"UNHEALTHY\"}) + 1 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"HEALTHY\"}) + 3 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"INITIAL\"}) + 4 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"DRAINING\"}) + 5 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"INACTIVE\"}) + 6 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"UNKNOWN\"})) * (time() - max without(state)(timestamp(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\"})) < bool 20) + 2 * (time() - max without(state)(timestamp(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\"})) >= bool 20)) * on(observer) group_left() (time() - soloapp_nlb_last_success_timestamp_seconds{observer=~\"$observer\"} < bool 20) + 2 * (0 * ((0 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"UNHEALTHY\"}) + 1 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"HEALTHY\"}) + 3 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"INITIAL\"}) + 4 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"DRAINING\"}) + 5 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"INACTIVE\"}) + 6 * sum without(state)(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\",state=\"UNKNOWN\"})) * (time() - max without(state)(timestamp(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\"})) < bool 20) + 2 * (time() - max without(state)(timestamp(soloapp_nlb_target_state{ingress=~\"$ingress\",observer=~\"$observer\"})) >= bool 20)) + 1) * on(observer) group_left() (time() - soloapp_nlb_last_success_timestamp_seconds{observer=~\"$observer\"} >= bool 20)",
          "legendFormat": "{{observer}} \u2192 {{ingress}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNHEALTHY",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                },
                "2": {
                  "text": "STALE",
                  "color": "orange"
                },
                "3": {
                  "text": "INITIAL",
                  "color": "yellow"
                },
                "4": {
                  "text": "DRAINING",
                  "color": "orange"
                },
                "5": {
                  "text": "INACTIVE",
                  "color": "gray"
                },
                "6": {
                  "text": "UNKNOWN",
                  "color": "orange"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "mergeValues": true
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "NLB API \u2014 observer freshness",
      "type": "timeseries",
      "description": "API read every 5s. A failed API read produces UNKNOWN targets; an absent/stalled observer must not be interpreted as healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - soloapp_nlb_last_success_timestamp_seconds{observer=~\"$observer\"}",
          "legendFormat": "{{observer}} last successful API read",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "2 \u00b7 HAProxy \u2192 DC \u2014 server state",
      "type": "state-timeline",
      "description": "Actual HAProxy state. Grafana home is a healthy backup: UP does not mean currently selected. Auth and Grafana route health are independent. Samples older than 20s are STALE; consult collector status before interpreting routing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(0 * sum without(state)(haproxy_server_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"DOWN\"}) + 1 * sum without(state)(haproxy_server_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"UP\"}) + 3 * sum without(state)(haproxy_server_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"MAINT\"}) + 4 * sum without(state)(haproxy_server_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"DRAIN\"}) + 5 * sum without(state)(haproxy_server_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"NOLB\"})) * (time() - max without(state)(timestamp(haproxy_server_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\"})) < bool 20) + 2 * (time() - max without(state)(timestamp(haproxy_server_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\"})) >= bool 20)",
          "legendFormat": "{{observer}} \u2192 {{ingress}} / {{proxy}} \u2192 {{server}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "2": {
                  "text": "STALE",
                  "color": "orange"
                },
                "3": {
                  "text": "MAINT",
                  "color": "gray"
                },
                "4": {
                  "text": "DRAIN",
                  "color": "orange"
                },
                "5": {
                  "text": "NOLB",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "mergeValues": true
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "HAProxy \u2014 last check result",
      "type": "state-timeline",
      "description": "L4TOUT/L6TOUT/L7TOUT = timeout; L4CON = connection error; L7STS = unexpected HTTP status; L7OK = successful HTTP check. Samples older than 20s are STALE; consult collector status before interpreting routing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(0 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"HANA\"}) + 1 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"SOCKERR\"}) + 3 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L4OK\"}) + 4 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L4TOUT\"}) + 5 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L4CON\"}) + 6 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L6OK\"}) + 7 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L6TOUT\"}) + 8 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L6RSP\"}) + 9 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L7TOUT\"}) + 10 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L7RSP\"}) + 11 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L7OK\"}) + 12 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L7OKC\"}) + 13 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"L7STS\"}) + 14 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"PROCERR\"}) + 15 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"PROCTOUT\"}) + 16 * sum without(state)(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\",state=\"PROCOK\"})) * (time() - max without(state)(timestamp(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\"})) < bool 20) + 2 * (time() - max without(state)(timestamp(haproxy_server_check_status{ingress=~\"$ingress\",observer=~\"$observer\",proxy=~\"auth_sites|grafana_sites|witness_reachability\"})) >= bool 20)",
          "legendFormat": "{{observer}} \u2192 {{ingress}} / {{proxy}} \u2192 {{server}}",
          "datasource": {
