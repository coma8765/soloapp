          "legendFormat": "{{observer}} / {{ingress}} \u2192 {{proxy}} / {{server}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
