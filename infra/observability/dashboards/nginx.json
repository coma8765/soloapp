      "targets": [
        {
          "refId": "A",
          "expr": "time() - timestamp(probe_success{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"healthz\"})",
          "legendFormat": "{{dc}} {{pod}}",
