    {
      "title": "HTTP 5xx share",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by(dc,route)(rate(soloapp_http_requests_total{dc=~\"$dc\",route=~\"$route\",status=~\"5..\"}[$__rate_interval])) or 0 * sum by(dc,route)(rate(soloapp_http_requests_total{dc=~\"$dc\",route=~\"$route\"}[$__rate_interval]))) / clamp_min(sum by(dc,route)(rate(soloapp_http_requests_total{dc=~\"$dc\",route=~\"$route\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "{{dc}} {{route}} {{status}}",
