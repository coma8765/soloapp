{
  "id": null,
  "uid": "soloapp-nginx",
  "title": "Soloapp \u00b7 Nginx",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "soloapp",
    "lite"
  ],
  "description": "Per-pod HTTP health probes and service-specific telemetry. Missing data is not success. Business HTTP latency/RPS are observed at nginx.",
  "links": [
    {
      "title": "Overview",
      "url": "/grafana/d/soloapp-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Auth",
      "url": "/grafana/d/soloapp-auth",
      "type": "link",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Whoami",
      "url": "/grafana/d/soloapp-whoami",
      "type": "link",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Nginx",
      "url": "/grafana/d/soloapp-nginx",
      "type": "link",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Infrastructure",
      "url": "/grafana/d/soloapp-infrastructure",
      "type": "link",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "Routing chain",
      "url": "/grafana/d/soloapp-routing",
      "type": "link",
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "PostgreSQL",
      "url": "/grafana/d/soloapp-postgres",
      "type": "link",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "dc",
        "type": "custom",
        "query": "yc,home",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(probe_success{service=\"nginx\",dc=~\"$dc\"},pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "nginx-.+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(soloapp_http_requests_total{dc=~\"$dc\"},route)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "/healthz \u2014 availability per pod",
      "type": "state-timeline",
      "description": "Real HTTP GET from local Alloy every 5s. Only 200 is healthy. STALE means sample age >=20s; gaps mean missing data, not success. Independent of kubelet probes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"healthz\"} * (time() - timestamp(probe_success{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"healthz\"}) < bool 20) + 2 * (time() - timestamp(probe_success{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"healthz\"}) >= bool 20)",
          "legendFormat": "{{dc}} {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "2": {
                  "text": "STALE",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "/healthz \u2014 response time",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"healthz\"}",
          "legendFormat": "{{dc}} {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "/healthz \u2014 HTTP status",
      "type": "timeseries",
      "description": "0 means no HTTP response (timeout, connection or transport failure). Expected 200.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
