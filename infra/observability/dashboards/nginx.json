    {
      "title": "Readiness \u2014 accepting traffic",
      "type": "state-timeline",
      "description": "Auth/whoami: /health/ready (includes 5xx cooldown); nginx: /healthz. Kubelet independently controls Service endpoints.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"readiness\"} * (time() - timestamp(probe_success{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"readiness\"}) < bool 20) + 2 * (time() - timestamp(probe_success{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"readiness\"}) >= bool 20)",
          "legendFormat": "{{dc}} {{pod}}",
          "datasource": {
