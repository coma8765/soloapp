      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{dc=~\"$dc\",service=\"nginx\",pod=~\"$pod\",check=\"healthz\"}",
          "legendFormat": "{{dc}} {{pod}}",
