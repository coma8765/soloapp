apiVersion: v1
kind: ConfigMap
metadata: {name: headlamp-clusters, namespace: observability}
data:
{% if oidc_enabled | default(false) %}
  config: {{ lookup('template', project_root ~ '/infra/headlamp/k8s/oidc-config.json.j2') | to_json }}
{% else %}
  config: |
    apiVersion: v1
    kind: Config
    current-context: yc
    clusters:
{% for site in groups['app_sites'] %}
    - name: {{ site }}
      cluster:
        server: https://{{ hostvars[site].private_ip }}:6443
        certificate-authority-data: {{ hostvars[site].headlamp_cluster_ca.content }}
{% endfor %}
    contexts:
{% for site in groups['app_sites'] %}
    - name: {{ site }}
      context: {cluster: {{ site }}, user: {{ site }}, namespace: soloapp}
{% endfor %}
    users:
{% for site in groups['app_sites'] %}
    - name: {{ site }}
      user: {}
{% endfor %}
{% endif %}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: headlamp-ui, namespace: observability}
automountServiceAccountToken: false
---
apiVersion: v1
kind: Service
metadata: {name: headlamp, namespace: observability}
spec:
  selector: {app: headlamp}
  ports: [{name: http, port: 4466, targetPort: http}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: headlamp, namespace: observability}
spec:
  replicas: {{ headlamp.replicas }}
  minReadySeconds: 5
  progressDeadlineSeconds: 300
  strategy: {type: RollingUpdate, rollingUpdate: {maxUnavailable: 0, maxSurge: 1}}
  selector: {matchLabels: {app: headlamp}}
  template:
    metadata:
      labels: {app: headlamp}
      annotations:
        oidc/enabled: '{{ oidc_enabled | default(false) | string | lower }}'
        checksum/clusters: '{{ groups["app_sites"] | map("extract", hostvars, "headlamp_cluster_ca") | list | to_json | hash("sha256") }}'
    spec:
      serviceAccountName: headlamp-ui
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 100
        runAsGroup: 101
        fsGroup: 101
        seccompProfile: {type: RuntimeDefault}
{% if oidc_enabled | default(false) %}
      initContainers:
      - name: oidc-config
        image: '{{ secrets_image }}'
        imagePullPolicy: Never
        command: [python3, -c]
        args:
        - |
          import json, pathlib, runpy
          runpy.run_path('/usr/local/bin/secret-fetch.py', run_name='__main__')
          config = json.loads(pathlib.Path('/base/config').read_text())
          secret = pathlib.Path('/run/soloapp-secrets/data/client-secret').read_text().strip()
          for user in config['users']:
              user['user']['auth-provider']['config']['client-secret'] = secret
          path = pathlib.Path('/headlamp/clusters/config')
          path.write_text(json.dumps(config))
          path.chmod(0o600)
        env:
        - {name: TOKEN_FILE, value: /run/identity/token}
        - {name: SERVICE_ACCOUNT_ID, value: '{{ cloud.identities["headlamp-oidc-" ~ inventory_hostname] }}'}
        - {name: SECRET_IDS, value: '{{ cloud.secrets["headlamp-oidc"] }}'}
        - {name: SECRET_DIR, value: /run/soloapp-secrets/data}
        resources:
          requests: {cpu: 10m, memory: 24Mi}
          limits: {cpu: 200m, memory: 64Mi}
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        volumeMounts:
        - {name: base, mountPath: /base, readOnly: true}
        - {name: identity, mountPath: /run/identity, readOnly: true}
        - {name: oidc-secrets, mountPath: /run/soloapp-secrets}
        - {name: config, mountPath: /headlamp/clusters}
{% endif %}
      containers:
      - name: headlamp
        image: {{ headlamp.image }}
        args: ['-kubeconfig=/headlamp/clusters/config', '-base-url={{ headlamp.base_path }}', '-plugins-dir=/headlamp/plugins'{% if oidc_enabled | default(false) %}, '-oidc-use-token-broadcast=true', '-oidc-use-pkce=true', '-oidc-use-cookie=true', '-oidc-callback-url=https://{{ public_domain }}/k8s/oidc-callback'{% endif %}]
        ports: [{name: http, containerPort: 4466}]
        resources: {{ headlamp.resources | to_json }}
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities: {drop: [ALL]}
        volumeMounts:
        - {name: config, mountPath: /headlamp/clusters, readOnly: true}
        - {name: tmp, mountPath: /tmp}
        readinessProbe:
          httpGet: {path: '{{ headlamp.base_path }}/', port: http}
          periodSeconds: 5
          timeoutSeconds: 2
        livenessProbe:
          httpGet: {path: '{{ headlamp.base_path }}/', port: http}
          periodSeconds: 10
          timeoutSeconds: 3
          failureThreshold: 3
        startupProbe:
          httpGet: {path: '{{ headlamp.base_path }}/', port: http}
          periodSeconds: 3
          failureThreshold: 40
      volumes:
{% if oidc_enabled | default(false) %}
      - name: config
        emptyDir: {medium: Memory, sizeLimit: 4Mi}
      - name: base
        configMap: {name: headlamp-clusters}
      - name: oidc-secrets
        emptyDir: {medium: Memory, sizeLimit: 4Mi}
      - name: identity
        projected:
          sources:
          - serviceAccountToken: {path: token, expirationSeconds: 600, audience: soloapp-lockbox}
{% else %}
      - name: config
        configMap: {name: headlamp-clusters}
{% endif %}
      - name: tmp
        emptyDir: {medium: Memory, sizeLimit: 32Mi}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata: {name: headlamp, namespace: observability}
spec:
  minAvailable: 1
  selector: {matchLabels: {app: headlamp}}
