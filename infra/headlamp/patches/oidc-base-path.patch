+// clusterRequest normalizes only the authentication lookup, leaving router paths intact.
+func (c *OIDCTokenRefreshConfig) clusterRequest(r *http.Request) *http.Request {
+	base := strings.TrimRight(c.BaseURL, "/")
+	if base == "" || !strings.HasPrefix(r.URL.Path, base+"/") {
+		return r
+	}
+	normalized := r.Clone(r.Context())
+	normalized.URL.Path = strings.TrimPrefix(r.URL.Path, base)
+	return normalized
+}
--- /dev/null
+++ b/backend/pkg/auth/basepath_test.go
@@ -0,0 +1,36 @@
+package auth
+
+import (
+	"github.com/kubernetes-sigs/headlamp/backend/pkg/telemetry"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestOIDCBasePathLookup(t *testing.T) {
+	c := OIDCTokenRefreshConfig{BaseURL: "/k8s"}
+	r := httptest.NewRequest("POST", "/k8s/clusters/home/apis/authorization.k8s.io/v1/selfsubjectrulesreviews", nil)
+	r.Header.Set("Authorization", "Bearer test-token")
+	cluster, token := ParseClusterAndToken(c.clusterRequest(r))
+	if cluster != "home" || token != "test-token" {
+		t.Fatalf("lookup failed: %q", cluster)
+	}
+	if r.URL.Path != "/k8s/clusters/home/apis/authorization.k8s.io/v1/selfsubjectrulesreviews" {
+		t.Fatal("routing path mutated")
+	}
+	other := httptest.NewRequest("GET", "/k8s-other/clusters/home", nil)
+	if c.clusterRequest(other) != other {
+		t.Fatal("unrelated prefix normalized")
+	}
+}
+
+func TestOIDCBasePathDoesNotSkipRefresh(t *testing.T) {
+	c := OIDCTokenRefreshConfig{BaseURL: "/k8s", TelemetryHandler: &telemetry.RequestHandler{}}
+	r := httptest.NewRequest("POST", "/k8s/clusters/home/apis/authorization.k8s.io/v1/selfsubjectrulesreviews", nil)
+	status := "success"
+	called := false
+	next := http.HandlerFunc(func(http.ResponseWriter, *http.Request) { called = true })
+	if c.shouldSkipOIDCRefresh(httptest.NewRecorder(), r, nil, &status, next) || called {
+		t.Fatal("refresh skipped for prefixed cluster path")
+	}
+}
