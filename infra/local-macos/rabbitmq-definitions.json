{
  "vhosts": [
    {
      "name": "/soloapp"
    }
  ],
  "queues": [
    {
      "name": "client-notify",
      "vhost": "/soloapp",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-quorum-initial-group-size": 1,
        "x-delivery-limit": -1
      }
    }
  ],
  "policies": [
    {
      "vhost": "/soloapp",
      "name": "delivery-deadline",
      "pattern": "^client-notify$",
      "apply-to": "quorum_queues",
      "priority": 10,
      "definition": {
        "consumer-timeout": 60000,
        "delayed-retry-type": "all",
        "delayed-retry-min": 1000,
        "delayed-retry-max": 1000
      }
    }
  ]
}
