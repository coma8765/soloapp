SECRET_IDS={{ delivery_secret_ids }}
SECRET_DIR=/run/soloapp-{{ delivery_name }}
FILE_UID={{ delivery_uid }}
{% if delivery_name != 'ingress' %}
SERVICE_ACCOUNT_ID={{ cloud.identities['node-' ~ inventory_hostname] }}
{% endif %}
{% if inventory_hostname == 'home' %}
KUBE_TOKEN=1
{% endif %}
{% if delivery_name == 'node' %}
PROFILE=node
RELOAD_POSTGRES={{ 'solo-monitor' if inventory_hostname == 'edge' else 'solo-postgres' }}
{% elif delivery_name == 'ingress' %}
RELOAD_HAPROXY=1
{% endif %}
