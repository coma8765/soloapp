[Unit]
Description=Deliver scoped {{ delivery_name }} secrets from Lockbox into RAM
After=network-online.target{% if inventory_hostname == 'home' %} k3s.service{% endif %}

[Service]
Type=oneshot
EnvironmentFile=/opt/hack-vk-26/{{ delivery_name }}-secrets.env
ExecStartPre=/usr/bin/install -d -o {{ delivery_uid }} -g {{ delivery_uid }} -m 700 /run/soloapp-{{ delivery_name }}
ExecStart=/usr/bin/python3 /opt/hack-vk-26/secret-fetch.py
UMask=0077
